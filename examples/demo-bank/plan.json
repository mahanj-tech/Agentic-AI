          "op": "select",
          "target": "label=To account",
          "value": "High-Yield Savings (****7788)"
        },
        {
          "op": "fill",
          "target": "label=Amount",
          "value": "5.00"
        },
        {
          "op": "click",
          "target": "css=#submit-transfer",
          "note": "Click the 'Transfer' submit button"
        },
        {
          "op": "capture",
          "target": "testid=balance-chk",
          "value": "number",
          "var": "chk_after"
        },
        {
          "op": "capture",
          "target": "testid=balance-sav",
          "value": "number",
          "var": "sav_after"
        },
        {
          "op": "click",
          "target": "Transactions",
          "note": "Click 'Transactions' in the top navigation"
        },
        {
          "op": "capture",
          "target": "css=#tx-table tbody tr",
          "value": "count",
          "var": "rows_after"
        }
      ],
      "checks": [
        {
          "kind": "expr",
          "description": "Exactly two new rows",
          "expr": "{rows_after} == {rows_before} + 2"
        },
        {
          "kind": "text_visible",
          "description": "Debit row names destination",
          "target": "css=#tx-table",
          "value": "to High-Yield Savings"
        },
        {
          "kind": "text_visible",
          "description": "Credit row names source",
          "target": "css=#tx-table",
          "value": "from Everyday Checking"
        }
      ],
      "expected": "Two new transactions: debit on Checking, credit on Savings."
    },
